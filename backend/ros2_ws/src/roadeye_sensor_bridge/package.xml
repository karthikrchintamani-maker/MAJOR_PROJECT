<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>roadeye_sensor_bridge</name>
  <version>1.0.0</version>
  <description>ROS2 bridge node for receiving ESP32 sensor hub telemetry over UDP/Sockets.</description>
  <maintainer email="dev@roadeye.ai">RoadEye Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>

  <depend>roadeye_dashboard_msgs</depend>
  <depend>roadeye_utils</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
